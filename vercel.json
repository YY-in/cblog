{
  "functions": {
    "api/**/*.py": {
      "includeFiles": [
        "config/**",
        "content/**",
        "templates/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
